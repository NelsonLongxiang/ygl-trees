#!/usr/bin/env bash
# pre-push gate — the CI-equivalent check that runs where there is no CI.
#
# The repo lives on GitHub now; this account runs no CI for it (private-repo
# Actions minutes are billed; chief engineer ruling direct-2c7c431a: local
# docker gate instead — see scripts/pg-gate.sh), so the gate lives here.
#
#   push to a branch  →  G9 ancestor guard (unskippable) + pnpm test
#   push of a TAG     →  G9 ancestor guard + pnpm test + pnpm pack:check
#
# Bypass deliberately (never silently):  YGL_SKIP_HOOKS=1 git push ...
#   skips ONLY the test suites — the G9 ancestor guard below still runs
#   (it is cheap; catching a non-fast-forward push before the transfer
#   beats re-discovering a lost merge afterwards).
#
# Install:  git config core.hooksPath .githooks
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

# ── G9 merge-ancestor guard (roadmap/#96 item 8) — runs BEFORE and
# INDEPENDENT of YGL_SKIP_HOOKS: a non-fast-forward push would silently
# drop remote history ("receipt real, code not on trunk" — dad595b).
G9_NONFF=0
TAG_PUSH=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/tags/*) TAG_PUSH=1 ;;
  esac
  # 删除推送（本地 sha 全零）不是非快进——放行（清理分支是合法操作）
  if [ "$_local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if [ -n "$_remote_sha" ] && [ "$_remote_sha" != "0000000000000000000000000000000000000000" ]; then
    if ! git merge-base --is-ancestor "$_remote_sha" "$_local_sha" 2>/dev/null; then
      G9_NONFF=1
      echo "pre-push: G9 NON-FAST-FORWARD — remote tip is not an ancestor of the local push"
      echo "  pull/rebase first. This guard is not skippable via YGL_SKIP_HOOKS."
    fi
  fi
done
[ "$G9_NONFF" = "0" ] || exit 1

if [ "${YGL_SKIP_HOOKS:-}" = "1" ]; then
  echo "pre-push: YGL_SKIP_HOOKS=1 → test suites skipped (G9 ancestor guard already ran above)"
  exit 0
fi


echo "pre-push gate: pnpm test (unit + build + demo)"
if ! pnpm test; then
  echo
  echo "pre-push: FAILED at 'pnpm test' — push blocked."
  echo "  fix the failure, or bypass deliberately with:  YGL_SKIP_HOOKS=1 git push"
  exit 1
fi

# verify meta (R3 登记面) — runs AFTER the test build so dist/bundle is fresh; a stale or
# missing bundle would misread as "registration drift" (#98 复核). Output kept visible.
echo "pre-push gate: verify meta (tooling registration face)"
if ! node dist/bundle/bin.cjs verify meta .; then
  echo
  echo "pre-push: FAILED at 'verify meta' — tooling[] registration drift in the COMMITTED state."
  echo "  fix: node scripts/meta-tooling.mjs --reregister <path> --reason \"<why>\" --actor <who>"
  echo "       node scripts/meta-tooling.mjs --add <path> --role <role> --actor <who>"
  exit 1
fi

if [ "$TAG_PUSH" = "1" ]; then
  echo "pre-push gate: tag push → also running 'pnpm pack:check' (publish-readiness)"
  if ! pnpm pack:check; then
    echo
    echo "pre-push: FAILED at 'pnpm pack:check' — tag push blocked (would ship an unverified artifact)."
    exit 1
  fi
fi

echo "pre-push: gates passed"
# Operational note: this hook takes ~2 minutes. A remote with an SSH idle
# timeout can drop the session while it runs, so the transfer right after
# fails with SIGPIPE / "Connection closed by remote host" even though the
# gates passed. The gates above are the evidence — retry with the documented
# bypass rather than re-running them over a dead connection:
#   YGL_SKIP_HOOKS=1 git push   (test suites only — the G9 ancestor
#                                guard re-runs on the retry; it cannot drop)
echo "pre-push: (if the transfer now fails with a broken pipe, that is the"
echo "pre-push:  remote's idle timeout during these 2 min — re-run with"
echo "pre-push:  YGL_SKIP_HOOKS=1 git push: test suites skip, G9 guard still runs)"
exit 0
