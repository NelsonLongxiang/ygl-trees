{
  "name": "ygl-trees",
  "version": "0.41.0",
  "description": "猿光 · 科技树 — database-centric CLI for research → production → knowledge reuse, built for AI agents.",
  "type": "commonjs",
  "main": "dist/apps/cli/index.js",
  "bin": {
    "ygl-trees": "dist/bundle/bin.cjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm build:bundle:only",
    "build:bundle:only": "tsdown apps/cli/src/bin.ts --format cjs --out-dir dist/bundle --platform node --target node20 --external better-sqlite3 --external node-sqlite3-wasm --external typeorm --external reflect-metadata --external pg --external @deepseek-ai/dsh-atomic-write",
    "build:bundle": "pnpm build",
    "start": "node dist/bundle/bin.cjs",
    "demo": "bash examples/demo.sh",
    "test": "pnpm test:unit && pnpm build && bash examples/demo.sh",
    "prepublishOnly": "pnpm test && pnpm pack:check",
    "test:unit": "vitest run",
    "smoke:bun": "bash scripts/bun-smoke.sh",
    "bench": "pnpm build && node benchmarks/bench.js",
    "pack:check": "bash scripts/pack-check.sh",
    "readme:verify": "bash scripts/readme-verify.sh"
  },
  "files": [
    "dist",
    "ygl.bundle.json",
    "README.md",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cosmokit": "workspace:~",
    "@deepseek-ai/dsh-atomic-write": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "workspace:~",
    "better-sqlite3": "^13.0.3",
    "node-sqlite3-wasm": "^0.8.60",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "optionalDependencies": {
    "pg": "^8.13.0"
  },
  "vitest": {
    "include": [
      "packages/*/*/tests/**/*.test.ts",
      "apps/*/tests/**/*.test.ts"
    ],
    "exclude": [
      "node_modules",
      "dist"
    ]
  }
}
