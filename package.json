{
  "name": "ygl-trees",
  "version": "0.88.0",
  "description": "Research workbench CLI for AI agents — evidence-first research pipeline, claims calibration and tech-tree skill modeling (SQLite; 猿光·科技树)",
  "type": "commonjs",
  "keywords": [
    "research",
    "workbench",
    "ai-agents",
    "agent-tools",
    "tech-tree",
    "skill-tree",
    "knowledge-base",
    "second-brain",
    "evidence",
    "research-pipeline",
    "claims",
    "decision-making",
    "cli",
    "sqlite",
    "mcp"
  ],
  "main": "dist/apps/cli/index.js",
  "bin": {
    "ygl-trees": "dist/bundle/bin.cjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm build:bundle:only && pnpm --filter @ygl/web build && node scripts/stage-web-dist.mjs",
    "build:bundle:only": "tsdown apps/cli/src/bin.ts --format cjs --out-dir dist/bundle --platform node --target node20 --deps.never-bundle better-sqlite3 --deps.never-bundle node-sqlite3-wasm --deps.never-bundle typeorm --deps.never-bundle reflect-metadata --deps.never-bundle pg --deps.never-bundle @deepseek-ai/dsh-atomic-write",
    "build:bundle": "pnpm build",
    "start": "node dist/bundle/bin.cjs",
    "demo": "bash examples/demo.sh",
    "test": "pnpm build && pnpm test:unit && bash examples/demo.sh && bash scripts/contract-audit.sh",
    "prepublishOnly": "pnpm test && pnpm pack:check",
    "test:unit": "vitest run --hook-timeout=60000 --test-timeout=20000 --maxWorkers=2",
    "smoke:bun": "bash scripts/bun-smoke.sh",
    "bench": "pnpm build && node benchmarks/bench.js",
    "pack:check": "bash scripts/pack-check.sh",
    "readme:verify": "bash scripts/readme-verify.sh",
    "contract:audit": "bash scripts/contract-audit.sh"
  },
  "files": [
    "dist",
    "ygl.bundle.json",
    "README.md",
    "docs",
    "CHANGELOG.md",
    "llms.txt",
    "skills"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@deepseek-ai/cosmokit": "workspace:~",
    "@deepseek-ai/dsh-atomic-write": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "workspace:~",
    "better-sqlite3": "^13.0.3",
    "node-sqlite3-wasm": "^0.8.61",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "optionalDependencies": {
    "pg": "^8.13.0"
  },
  "vitest": {
    "include": [
      "packages/*/*/tests/**/*.test.ts",
      "apps/*/tests/**/*.test.ts"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "tmp"
    ],
    "env": {
      "YGL_TEST": "1"
    },
    "hookTimeout": 30000,
    "testTimeout": 20000
  }
}
