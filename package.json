{
  "name": "ygl-trees",
  "version": "0.34.1",
  "description": "猿光 · 科技树 — database-centric CLI for research → production → knowledge reuse, built for AI agents.",
  "type": "commonjs",
  "main": "dist/apps/cli/index.js",
  "bin": {
    "ygl-trees": "bin/ygl-trees.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node bin/ygl-trees.js",
    "demo": "bash examples/demo.sh",
    "test": "pnpm test:unit && pnpm build && bash examples/demo.sh",
    "prepublishOnly": "pnpm test",
    "test:unit": "vitest run",
    "smoke:bun": "bash scripts/bun-smoke.sh",
    "bench": "pnpm build && node benchmarks/bench.js"
  },
  "files": [
    "bin",
    "dist",
    "ygl.bundle.json",
    "README.md",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "better-sqlite3": "^13.0.3",
    "cordis": "workspace:~",
    "cosmokit": "workspace:~",
    "node-sqlite3-wasm": "^0.8.60",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "optionalDependencies": {
    "pg": "^8.13.0"
  },
  "vitest": {
    "include": [
      "packages/*/*/tests/**/*.test.ts"
    ]
  }
}
